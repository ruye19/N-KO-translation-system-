# ---------------------------------------------------------------------------
# N'Ko Translator - backend configuration
#
# Copy this file to `backend/.env` and fill in real values there.
# `.env` is git-ignored. NEVER put a real key in this example file.
# ---------------------------------------------------------------------------

# Which provider implementation to use: anthropic | gemini
# Only the selected provider's key is needed.
TRANSLATION_PROVIDER=gemini

# --- Anthropic credentials -------------------------------------------------
# Get a key from https://console.anthropic.com/ -> API keys.
# This stays on the server. It is never sent to the browser.
ANTHROPIC_API_KEY=

# Model to use. Keep this configurable so it can be changed without code edits.
ANTHROPIC_MODEL=claude-opus-5

# Maximum tokens in the generated translation.
ANTHROPIC_MAX_TOKENS=4096

# How hard the model works: low | medium | high | xhigh | max
# "medium" keeps the endpoint responsive and cheap; raise it if translation
# quality testing shows it helps.
ANTHROPIC_EFFORT=medium

# Seconds to wait for the provider before giving up.
REQUEST_TIMEOUT_SECONDS=60

# --- Google Gemini ---------------------------------------------------------
# Used when TRANSLATION_PROVIDER=gemini.
# Create a key at https://aistudio.google.com/apikey -- it starts with "AIza".
# A token starting "AQ." is a short-lived ephemeral token and will expire.
GEMINI_API_KEY=

# Model name. gemini-3.8-flash is responsive and active on the v1beta API.
GEMINI_MODEL=gemini-3.8-flash

# Maximum tokens in the generated translation.
GEMINI_MAX_TOKENS=4096

# Low temperature: translation should be faithful, not creative.
GEMINI_TEMPERATURE=0.2

# --- Provider retry --------------------------------------------------------
# Gemini only. At most one retry of a temporary failure (429/500/502/503 or a
# failed connection). Never retried: bad key, bad request, unknown model,
# 504/timeouts. 0 disables; values above 1 are capped at 1.
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_DELAY_SECONDS=1.0
# If Google asks to wait longer than this, the error is returned instead.
PROVIDER_RETRY_MAX_DELAY_SECONDS=5.0

# --- Access key ------------------------------------------------------------
# Shared secret that callers (Mansa's backend) send as:
#   Authorization: Bearer <key>
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Several keys may be listed, comma-separated, to rotate without downtime.
# With no key set, /api/translate refuses every request (503).
# NEVER put a real key in this example file or in any frontend code.
TRANSLATOR_API_KEY=

# true (default): the key is required. Set false ONLY for local development
# with the bundled browser frontend, which cannot hold a secret.
REQUIRE_API_KEY=true

# --- Rate limiting ---------------------------------------------------------
# Requests to /api/translate allowed per client address per window.
# Counted per worker process, in memory. 0 disables the limit.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Input limits ----------------------------------------------------------
# Characters accepted in one request. Covers words, sentences and short or
# medium paragraphs. Whole-document translation is out of scope for v1.
MAX_INPUT_CHARS=5000

# --- Dictionary ------------------------------------------------------------
# Optional. Set DICTIONARY_ENABLED=true once the extraction pipeline has run
# (python scripts/extract_dictionary.py from repo root).
# When enabled, French headwords from the 32,000+ entry SQLite database are supplied
# to the model as reference context. N'Ko entries are marked unverified pending font resolution.
DICTIONARY_ENABLED=false
# Path to SQLite DB. If omitted, the service auto-discovers data/dictionary.sqlite.
DICTIONARY_DB_PATH=../data/dictionary.sqlite

# --- CORS ------------------------------------------------------------------
# Comma-separated origins allowed to call this API (the frontend's address).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
